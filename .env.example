# Local docker-compose environment. Copy to .env before running `docker compose up`.

POSTGRES_USER=minishop
POSTGRES_PASSWORD=minishop
POSTGRES_DB=minishop
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

CATALOG_URL=http://catalog:8000
ORDER_URL=http://order:8000

# Order processing experiment flag.
EXPERIMENT_FLAG=

# Notification cache behavior.
CACHE_MODE=

# Catalog request handling profile.
THROTTLE_MODE=

# Optional: override SQLAlchemy pool sizing per service (all default to 5/5
# in code if unset - leave unset locally).
# DB_POOL_SIZE=
# DB_MAX_OVERFLOW=
